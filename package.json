{
  "name": "yanki",
  "productName": "YANKI",
  "version": "1.1.0",
  "description": "YANKI",
  "main": "main.js",
  "author": "YANKI",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "start:2": "electron . --profile=ikinci",
    "test": "node test/p2p.test.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "hyperswarm": "^4.8.4"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "app.yanki.desktop",
    "productName": "YANKI",
    "artifactName": "YANKI-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "mac": {
      "category": "public.app-category.social-networking",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Sesli sohbet için mikrofon erişimi gerekir.",
        "NSCameraUsageDescription": "Görüntülü sohbet için kamera erişimi gerekir.",
        "NSLocalNetworkUsageDescription": "Yerel ağdaki eşleri bulmak için gerekir.",
        "NSAppleEventsUsageDescription": "Spotify veya Müzik uygulamasında çalan şarkıyı profilinde göstermek için gerekir.",
        "CFBundleDisplayName": "YANKI"
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "legalTrademarks": "YANKI"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "YANKI"
    },
    "copyright": "Copyright © 2026 YANKI",
    "executableName": "YANKI"
  }
}
